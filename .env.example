# Dr Megersa Dental Clinic - Environment Configuration

# Session & Security
# Used to sign HttpOnly admin authentication cookies
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min_32_characters

# Admin Authentication
# Initial password for /admin portal (Default fallback: MegersaDental2026!Adama)
ADMIN_PASSWORD=MegersaDental2026!Adama

# Emergency Recovery Key
# Entering this key into the /admin password field will immediately grant access
# and bypass any forgotten password or lockout (Default fallback: MegersaRecovery2026!Adama)
ADMIN_RECOVERY_KEY=MegersaRecovery2026!Adama
