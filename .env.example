# Dr Megersa Dental Clinic - Environment Configuration

# Session & Security
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min_32_characters

# Initial Admin Password (used only if database has not set a password yet)
# Change immediately after logging into the admin panel at /admin
ADMIN_INITIAL_PASSWORD=MegersaDental2026!Adama

# Database Configuration
# In local development: defaults to durable local file "file:leads.db"
# In Vercel / Cloud deployment: provide Turso or LibSQL credentials for durable persistence
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
